{
  "name": "impeccable",
  "version": "0.1.0",
  "description": "Real-time orderflow analytics for onchain trading — Level 2 orderbook, MEV detection, and execution quality scoring",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/env": "^5.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^2.0.0",
    "better-sqlite3": "^12.10.0",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "viem": "2.48.11",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}